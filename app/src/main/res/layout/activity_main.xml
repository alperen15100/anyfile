<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/homeScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/homeHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/main_subtitle"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/by_ecrin_labs"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openHeroButton"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/open_any_file"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconGravity="textStart" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_tools_teaser"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openToolsButton"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:text="@string/tools"
                                app:cornerRadius="14dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/privacy_note"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="24dp" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/toolsScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tools_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tools_subtitle"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/pdf_tools"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolPdfMerge" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/pdf_merge" app:icon="@android:drawable/ic_menu_add" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolPdfSplit" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/pdf_split" app:icon="@android:drawable/ic_menu_crop" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolPdfImages" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/pdf_to_images" app:icon="@android:drawable/ic_menu_gallery" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolMultiPdf" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/images_pdf" app:icon="@android:drawable/ic_menu_save" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolTextPdf" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_text_pdf" app:icon="@android:drawable/ic_menu_edit" app:cornerRadius="15dp"/>
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/image_tools"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolJpg" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_jpg" app:icon="@android:drawable/ic_menu_camera" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolPng" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_png" app:icon="@android:drawable/ic_menu_gallery" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolImagePdf" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_image_pdf" app:icon="@android:drawable/ic_menu_save" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolCompressImage" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/compress_image" app:icon="@android:drawable/ic_menu_manage" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolResizeImage" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/resize_image" app:icon="@android:drawable/ic_menu_crop" app:cornerRadius="15dp"/>
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/archive_tools"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolCreateZip" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/create_zip" app:icon="@android:drawable/ic_menu_save" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolExtractZip" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/extract_zip" app:icon="@android:drawable/ic_menu_upload" app:cornerRadius="15dp"/>
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/file_tools"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolDetect" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/detect_file" app:icon="@android:drawable/ic_menu_help" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolInfo" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_info" app:icon="@android:drawable/ic_menu_info_details" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolSearch" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_search" app:icon="@android:drawable/ic_menu_search" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolFavorites" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/tool_favorites" app:icon="@android:drawable/btn_star_big_on" app:cornerRadius="15dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/toolManageFile" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:text="@string/manage_file" app:icon="@android:drawable/ic_menu_manage" app:cornerRadius="15dp"/>
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/tools_footer"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/openFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/open_a_file" />
</FrameLayout>
